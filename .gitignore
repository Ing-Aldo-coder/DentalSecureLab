# ============================================
# DentalSecureLab - .gitignore
# ============================================

# Entornos virtuales de Python
env/
venv/
.venv/

# Base de datos local
db.sqlite3
db.sqlite3-journal

# Variables de entorno / secretos
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class

# Archivos de caché
.pytest_cache/
.mypy_cache/

# Logs
*.log

# Archivos temporales
*.tmp
*.temp
*.bak

# Visual Studio Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Archivos de cobertura/pruebas
.coverage
htmlcov/

# Django - archivos generados localmente
staticfiles/
media/