# ==============================================================================
# DentalSecureLab - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# Copie este archivo como '.env' en la raíz del proyecto y configure valores
# reales y seguros para el entorno de producción. NUNCA suba el archivo '.env'
# a repositorios públicos o compartidos.
# ==============================================================================

# Control de depuración (OBLIGATORIO: False en producción)
DEBUG=False

# Clave criptográfica de Django (genere una cadena aleatoria de 50+ caracteres)
SECRET_KEY=cambiar-por-una-clave-secreta-robusta-y-aleatoria-en-produccion-50-caracteres

# Dominios y direcciones IP autorizadas (separadas por comas sin espacios)
ALLOWED_HOSTS=127.0.0.1,localhost,dentalsecurelab.clinica.local

# Redirección forzada y banderas de transporte seguro HTTPS (True en producción)
SECURE_SSL_REDIRECT=False
